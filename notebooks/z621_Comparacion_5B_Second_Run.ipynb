require("data.table")

if( !require("yaml")) install.packages("yaml")
require("yaml")





PARAM <- list()

PARAM$experimentos <- c("5B1", "5B2", "5B3", "5B4")

# corrida que se compara: lee las carpetas WF5Bx_Second_Run y los archivos que terminan en _5Bx_Second_Run
PARAM$corrida <- "Second_Run"

PARAM$semillas <- c(
  701669, 743027, 766957, 780523, 795493,
  163741, 195401, 751643, 959473, 983327
)

# carpeta donde estan WF5B1, WF5B2, WF5B3, WF5B4
PARAM$carpeta_exp <- "/content/buckets/b1/exp"

# carpeta de salida de esta notebook, no pisa la de ningun experimento
PARAM$carpeta_salida <- paste0("WF5B_comparacion_", PARAM$corrida)

# test de Wilcoxon
PARAM$wilcoxon$alfa <- 0.05
PARAM$wilcoxon$correccion <- "holm"   # cualquier metodo de p.adjust(): "holm", "bonferroni", "BH", ...

# ancho de la media movil, el mismo que en Produccion
PARAM$ventana_suavizado <- 400

# rango de envios que se muestra en el grafico
PARAM$grafico$xlim <- c(0, 20000)


# carpeta de trabajo
setwd( PARAM$carpeta_exp )
dir.create( PARAM$carpeta_salida, showWarnings=FALSE )
setwd( file.path(PARAM$carpeta_exp, PARAM$carpeta_salida) )

# carpeta de cada experimento
carpeta_de <- function(exp) file.path( PARAM$carpeta_exp, paste0("WF", exp, "_", PARAM$corrida) )

# sufijo de los archivos de cada experimento, y de los archivos que graba esta notebook
sufijo_de <- function(exp) paste0("_", exp, "_", PARAM$corrida)
sufijo_salida <- paste0("_5B_", PARAM$corrida)

for( exp in PARAM$experimentos )
  if( !dir.exists(carpeta_de(exp)) ) stop( "No existe la carpeta ", carpeta_de(exp) )





tb_ganancias <- rbindlist( lapply( PARAM$experimentos, function(exp) {

  y <- read_yaml( file.path(carpeta_de(exp), paste0("ganancias_produccion", sufijo_de(exp), ".yml")) )
  tb_yml <- data.table( experimento= exp, semilla= as.numeric(y$semillas), ganancia= as.numeric(y$ganancias) )

  tb_txt <- fread( file.path(carpeta_de(exp), paste0("ganancias_produccion", sufijo_de(exp), ".txt")) )

  tb <- merge( tb_yml, tb_txt[, list(semilla= as.numeric(semilla), ganancia_txt= ganancia_suavizada_max, envios)],
               by= "semilla", all.x= TRUE )

  stopifnot( nrow(tb) == 10,
             setequal(tb$semilla, PARAM$semillas),
             !anyNA(tb$ganancia),
             isTRUE(all.equal(tb$ganancia, tb$ganancia_txt)) )

  tb[, ganancia_txt := NULL ]
  tb
}))

setcolorder( tb_ganancias, c("experimento", "semilla") )

# tabla ancha: una fila por semilla, una columna por experimento (asi se empareja el Wilcoxon)
tb_ancha <- dcast( tb_ganancias, semilla ~ experimento, value.var= "ganancia" )
tb_ancha <- tb_ancha[ match(PARAM$semillas, semilla) ]
stopifnot( nrow(tb_ancha) == 10, !anyNA(tb_ancha) )

tb_ancha





tb_curvas <- rbindlist( lapply( PARAM$experimentos, function(exp) {

  curvas <- sapply( PARAM$semillas, function(s) {
    archivo <- file.path( carpeta_de(exp), paste0("ganancias_s", s, sufijo_de(exp), ".txt") )
    if( !file.exists(archivo) ) stop( "No existe ", archivo )
    fread( archivo, select= "gan_acum" )$gan_acum
  })
  # sapply devuelve una matriz envios x semillas, si alguna curva tuviera otro largo devolveria una lista
  stopifnot( is.matrix(curvas), ncol(curvas) == 10 )

  data.table(
    experimento= exp,
    envios= seq_len(nrow(curvas)),
    gan_media= rowMeans(curvas),
    gan_min= apply(curvas, 1, min),
    gan_max= apply(curvas, 1, max)
  )
}))

# todas las curvas deben tener el mismo largo (misma cantidad de clientes en 202107)
stopifnot( uniqueN( tb_curvas[, .N, by= experimento]$N ) == 1 )

# media movil de ancho 400, igual que en Produccion
tb_curvas[,
  gan_media_suavizada := frollmean(
    x= gan_media,
    n= PARAM$ventana_suavizado,
    align= "center",
    na.rm= TRUE,
    hasNA= TRUE
  ),
  by= experimento
]

# maximo de la curva promedio suavizada
tb_max_curva <- tb_curvas[, list(
    ganancia_max_curva_promedio= max(gan_media_suavizada, na.rm= TRUE),
    envios_max_curva_promedio= envios[ which.max(gan_media_suavizada) ]
  ), by= experimento ]

tb_max_curva

fwrite( tb_curvas, file= paste0("curvas_promedio", sufijo_salida, ".txt"), sep= "\t" )





colores <- c("#1b9e77", "#d95f02", "#7570b3", "#e7298a")
names(colores) <- PARAM$experimentos

graficar_curvas <- function() {

  tb_plot <- tb_curvas[ envios <= PARAM$grafico$xlim[2] ]
  ylim <- c( 0, max(tb_plot$gan_max, na.rm= TRUE) * 1.05 )

  plot( NULL,
    xlim= PARAM$grafico$xlim,
    ylim= ylim,
    main= paste0("Curva de ganancia promedio (10 semillas) - produccion 202107 - ", PARAM$corrida),
    xlab= "Envios",
    ylab= "Ganancia acumulada",
    panel.first= grid()
  )

  for( exp in PARAM$experimentos ) {
    t <- tb_plot[ experimento == exp ]
    polygon( c(t$envios, rev(t$envios)), c(t$gan_min, rev(t$gan_max)),
             col= adjustcolor(colores[exp], alpha.f= 0.15), border= NA )
  }

  for( exp in PARAM$experimentos ) {
    t <- tb_plot[ experimento == exp ]
    lines( t$envios, t$gan_media, col= colores[exp], lwd= 2 )

    m <- tb_max_curva[ experimento == exp ]
    points( m$envios_max_curva_promedio, m$ganancia_max_curva_promedio, col= colores[exp], pch= 19, cex= 1.3 )
  }

  legend( "topright",
    legend= paste0( tb_max_curva$experimento, "   max= ", round(tb_max_curva$ganancia_max_curva_promedio, 2),
                    "   envios= ", tb_max_curva$envios_max_curva_promedio ),
    col= colores[tb_max_curva$experimento], lwd= 2, pch= 19, cex= 0.8, bg= "white" )
}

# en la notebook
options( repr.plot.width= 12, repr.plot.height= 7 )
graficar_curvas()

# a disco
pdf( paste0("curvas_de_ganancia", sufijo_salida, ".pdf"), width= 12, height= 7 )
graficar_curvas()
invisible( dev.off() )





tb_resumen <- tb_ganancias[, list(
    ganancia_media= mean(ganancia),
    ganancia_desvio= sd(ganancia),
    ganancia_mediana= median(ganancia),
    ganancia_min= min(ganancia),
    ganancia_max= max(ganancia),
    envios_medio= mean(envios)
  ), by= experimento ]

tb_resumen <- merge( tb_resumen, tb_max_curva, by= "experimento" )
setorder( tb_resumen, -ganancia_media )

tb_resumen

fwrite( tb_resumen, file= paste0("tabla_resumen", sufijo_salida, ".txt"), sep= "\t" )





pares <- combn( PARAM$experimentos, 2, simplify= FALSE )

tb_wilcoxon <- rbindlist( lapply( pares, function(p) {

  a <- tb_ancha[[ p[1] ]]
  b <- tb_ancha[[ p[2] ]]
  d <- a - b

  # el p-valor exacto solo es posible si no hay diferencias nulas ni empates en |d|
  exacto <- !any(d == 0) && !anyDuplicated(abs(d))

  if( all(d == 0) ) {
    # ganancias identicas en todas las semillas: no hay diferencia (wilcox.test devolveria NaN)
    wt <- list( statistic= 0, p.value= 1, estimate= 0 )
  } else {
    wt <- tryCatch(
      suppressWarnings( wilcox.test( a, b, paired= TRUE, alternative= "two.sided",
                                     exact= exacto, conf.int= TRUE ) ),
      # con muchos empates puede fallar el intervalo de confianza: repito sin el y uso la mediana
      error= function(e) {
        w <- suppressWarnings( wilcox.test( a, b, paired= TRUE, alternative= "two.sided", exact= exacto ) )
        w$estimate <- median(d)
        w
      }
    )
  }

  data.table(
    exp_A= p[1],
    exp_B= p[2],
    media_A= mean(a),
    media_B= mean(b),
    dif_media= mean(d),
    dif_hodges_lehmann= unname(wt$estimate),
    semillas_gana_A= sum(d > 0),
    semillas_gana_B= sum(d < 0),
    semillas_empate= sum(d == 0),
    V= unname(wt$statistic),
    p_valor= wt$p.value,
    p_exacto= exacto
  )
}))

tb_wilcoxon[, p_ajustado := p.adjust( p_valor, method= PARAM$wilcoxon$correccion ) ]
tb_wilcoxon[, significativo := p_ajustado < PARAM$wilcoxon$alfa ]
tb_wilcoxon[, resultado := fifelse( !significativo, "sin diferencia significativa",
                              paste( fifelse(dif_hodges_lehmann > 0, exp_A, exp_B), "es superior" ) ) ]

stopifnot( nrow(tb_wilcoxon) == 6, !anyNA(tb_wilcoxon$p_ajustado) )

tb_wilcoxon

fwrite( tb_wilcoxon, file= paste0("wilcoxon", sufijo_salida, ".txt"), sep= "\t" )





mat_p <- matrix( NA_real_, 4, 4, dimnames= list(PARAM$experimentos, PARAM$experimentos) )
for( i in seq_len(nrow(tb_wilcoxon)) ) {
  mat_p[ tb_wilcoxon$exp_A[i], tb_wilcoxon$exp_B[i] ] <- tb_wilcoxon$p_ajustado[i]
  mat_p[ tb_wilcoxon$exp_B[i], tb_wilcoxon$exp_A[i] ] <- tb_wilcoxon$p_ajustado[i]
}
round( mat_p, 4 )





tb_ranking <- rbindlist( lapply( PARAM$experimentos, function(exp) {

  t <- tb_wilcoxon[ exp_A == exp | exp_B == exp ]
  gana <- t[ significativo == TRUE & resultado == paste(exp, "es superior") ]
  pierde <- t[ significativo == TRUE & resultado != paste(exp, "es superior") ]
  empata <- t[ significativo == FALSE ]
  otros_empata <- setdiff( c(empata$exp_A, empata$exp_B), exp )

  data.table(
    experimento= exp,
    victorias= nrow(gana),
    derrotas= nrow(pierde),
    sin_diferencia= nrow(empata),
    puntaje= nrow(gana) - nrow(pierde),
    ganancia_media= mean( tb_ancha[[exp]] ),
    ganancia_mediana= median( tb_ancha[[exp]] ),
    sin_diferencia_con= paste( sort(otros_empata), collapse= ", " )
  )
}))

setorder( tb_ranking, -puntaje, -ganancia_media )
tb_ranking[, puesto := .I ]
setcolorder( tb_ranking, "puesto" )

# el puesto i se distingue estadisticamente del puesto i+1 ?
distinto_del_siguiente <- function(i) {
  if( i == nrow(tb_ranking) ) return( NA )
  e1 <- tb_ranking$experimento[i]; e2 <- tb_ranking$experimento[i + 1]
  tb_wilcoxon[ (exp_A == e1 & exp_B == e2) | (exp_A == e2 & exp_B == e1), significativo ]
}
tb_ranking[, distinto_del_siguiente := sapply( puesto, distinto_del_siguiente ) ]

tb_ranking

fwrite( tb_ranking, file= paste0("ranking", sufijo_salida, ".txt"), sep= "\t" )





primero <- tb_ranking[1]
n_sig <- tb_wilcoxon[, sum(significativo)]

if( n_sig == 0 ) {
  conclusion <- paste0(
    "Ninguna de las 6 comparaciones es significativa (alfa= ", PARAM$wilcoxon$alfa,
    ", correccion ", PARAM$wilcoxon$correccion, "). ",
    "No hay evidencia de que alguna configuracion supere a las demas; ",
    "el orden 1 a 4 es solo por ganancia media." )
} else if( primero$victorias == length(PARAM$experimentos) - 1 ) {
  conclusion <- paste0(
    primero$experimento, " es significativamente superior a los otros tres experimentos ",
    "(alfa= ", PARAM$wilcoxon$alfa, ", correccion ", PARAM$wilcoxon$correccion, ")." )
} else {
  conclusion <- paste0(
    primero$experimento, " queda primero (puntaje ", primero$puntaje,
    ", ganancia media ", round(primero$ganancia_media, 2), "), pero no se diferencia significativamente de: ",
    primero$sin_diferencia_con, ". ",
    "Hay ", n_sig, " comparacion(es) significativa(s) de 6: ",
    paste( tb_wilcoxon[ significativo == TRUE, paste0(resultado, " a ", fifelse(resultado == paste(exp_A, "es superior"), exp_B, exp_A)) ],
           collapse= "; " ), "." )
}

cat( conclusion, "\n" )


# grabo los parametros y los resultados
PARAM$resultado <- list(
  ranking= as.list( tb_ranking[, list(puesto, experimento, puntaje, ganancia_media)] ),
  conclusion= conclusion
)

write_yaml( PARAM, file= paste0("PARAM_comparacion", sufijo_salida, ".yml") )

